{
  "manifest_version": 3,
  "name": "Visual Tab Manager",
  "version": "1.0.0",
  "description": "Visual tab switching with captured page element previews.",
  "author": "Visual Tab Manager Team",
  "browser_specific_settings": {
    "gecko": {
      "id": "visual-tab-manager@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon-16.svg",
      "32": "icon-32.svg",
      "48": "icon-48.svg",
      "128": "icon-128.svg"
    },
    "default_title": "VTM"
  },
  "icons": {
    "16": "icon-16.svg",
    "32": "icon-32.svg",
    "48": "icon-48.svg",
    "128": "icon-128.svg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/content-picker.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
